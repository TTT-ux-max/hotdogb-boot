# 本地覆盖模板：复制为 config/local.env 后按需修改（该文件已被 .gitignore 排除）
#
# cp config/local.env.example config/local.env

# 默认档位与并发
PROFILE=clean
JOBS=4

# 已有 AOSP/LineageOS 源码树时，离线复用其工具链（推荐本地开发用）
# LOCAL_PREBUILTS=/root/lineage-18.1

# 官方工具链源不可达时，改成自己的镜像 / Release asset 直链
# CLANG_ARCHIVE_URL=https://example.com/clang-r383902b1.tar.gz
# GCC64_URL=https://example.com/gcc64.tar.gz
# GCC32_URL=https://example.com/gcc32.tar.gz
# BUILDTOOLS_URL=https://example.com/build-tools.tar.gz

# 在线 build-tools 下载失败时改用系统 make/flex/bison/m4
# USE_SYSTEM_HOST_TOOLS=1
