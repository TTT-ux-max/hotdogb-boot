# hotdogb boot 编译工程 —— 可覆盖的默认参数
# 用法：复制本文件为 config/local.env 后修改，脚本会优先读取 local.env

# 内核配置档位：stock(官方原版) | clean(官方+HIDRAW，已验证可开机) | custom(VR/Docker 全开)
PROFILE="${PROFILE:-clean}"

# 并行编译数。本地 8 GiB 内存墙建议 4；GitHub Actions runner(4C/16G) 建议 4~8
JOBS="${JOBS:-4}"

# 内核源码目录（相对工程根）
KERNEL_DIR="${KERNEL_DIR:-kernel}"

# 已有 AOSP/LineageOS 源码树根（本地模式）。设置后直接复用其 prebuilts/ 工具链，不再联网下载
# 例：LOCAL_PREBUILTS=/root/lineage-18.1
LOCAL_PREBUILTS="${LOCAL_PREBUILTS:-}"

# 在线工具链下载地址（GitHub Actions 默认走这里）
# 若官方源不可达，可用环境变量 / config/local.env 覆盖成自己的镜像或 GitHub Release asset URL
CLANG_NAME="${CLANG_NAME:-clang-r383902b1}"
CLANG_ARCHIVE_URL="${CLANG_ARCHIVE_URL:-https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/refs/heads/android11-qpr3-release/clang-r383902b1.tar.gz}"
GCC64_URL="${GCC64_URL:-https://codeload.github.com/LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9/tar.gz/refs/heads/lineage-19.1}"
GCC32_URL="${GCC32_URL:-https://codeload.github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9/tar.gz/refs/heads/lineage-19.1}"
BUILDTOOLS_URL="${BUILDTOOLS_URL:-https://codeload.github.com/LineageOS/android_prebuilts_build-tools/tar.gz/refs/heads/lineage-18.1}"

# 若在线 build-tools 不可用，改为使用系统 make/flex/bison/m4（apt 安装）
USE_SYSTEM_HOST_TOOLS="${USE_SYSTEM_HOST_TOOLS:-0}"

# 产物文件名前缀
OUT_NAME="${OUT_NAME:-boot}"
