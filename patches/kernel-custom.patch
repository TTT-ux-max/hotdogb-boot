@@ -792,3 +792,123 @@ CONFIG_AIGOV=y
 CONFIG_IM=y
 CONFIG_PCCORE=y
 CONFIG_UXCHAIN=y
+
+# ---- HUAWEI VR Glass (CV10) / hotdogb ------------------------------------
+# VR 框架内核依赖（由 02-vr-integration 脚本反推）：
+#  * /dev/hidraw*  : 眼镜/手柄 IMU、触控、按键的原始 HID report 回传
+#  * USB HID / UHID: USB 与蓝牙 HID over GATT 注入内核 HID 栈（UHID 已启用）
+#  * USB 枚举      : /sys/bus/usb/devices/*/idVendor|idProduct（VID 12d1）
+#  * Type-C / DP   : 高通自研 PD 栈 CONFIG_USB_PD_POLICY + QPNP_USB_PDPHY（已启用）
+#  * DRM card0-*   : SDE/DP 连接状态（CONFIG_DRM_MSM 已启用，显式声明）
+#  * power_supply  : VBUS Source / OTG 升压（CONFIG_QPNP_SMB5 已启用，显式声明）
+#  * wakelock      : HIGH_RES_TIMERS / PREEMPT / PM_WAKELOCKS 已启用
+# 注意：本内核为 4.14 高通分支，不存在上游 TYPEC_DP_ALTMODE / USB_ROLE_SWITCH /
+#       DMABUF_HEAPS，勿引入以免与自研 PD 栈冲突。
+CONFIG_HID=y
+CONFIG_HIDRAW=y
+CONFIG_USB_HID=y
+CONFIG_HID_GENERIC=y
+CONFIG_HID_BATTERY_STRENGTH=y
+CONFIG_BT_HIDP=y
+CONFIG_BT_LE=y
+CONFIG_DRM_MSM=y
+CONFIG_POWER_SUPPLY=y
+
+# ---- docker-enabled-oneplus7t-kernel fixes (merged 2026-11-13) ----
+# 来源: https://github.com/raj-sh-git/docker-enabled-oneplus7t-kernel
+# 只合并配置修复；不替换源码（源仓库为 LOS23/4.14.357，与本工程 LOS18.1 版本不同）。
+# 刻意不合并 CONFIG_LOCALVERSION="-perf-g6ecfabed032b"：那是 LOS23 vendor 模块 vermagic，
+# 照搬会让本工程从 OOS11 提取的 *.ko (wlan 等) 因 vermagic 不符而全部加载失败。
+# 刻意不合并 CONFIG_USB_PD：本工程用高通自研 CONFIG_USB_PD_POLICY，避免双 PD 栈冲突。
+# CONFIG_SYSVIPC / CONFIG_SYSVIPC_SYSCTL 刻意保持关闭(不设 =y)。
+# 原因: Android 11 framework compatibility matrix 要求 CONFIG_SYSVIPC=n
+#   (安全基线, kernel/configs/q/android-4.14/android-base.config:
+#    "# CONFIG_SYSVIPC is not set")。若置 y, OTA 打包阶段 ota_from_target_files
+#   的 checkvintf 会报 "For config CONFIG_SYSVIPC, value = y but required n"
+#   → RuntimeError: VINTF compatibility check failed, 无法出 zip。
+# Docker 引擎/runc 依赖的是 namespaces/cgroups/netfilter/overlayfs/POSIX mqueue,
+#   不依赖 SysV IPC; 这些均已在下方保留, 故关闭 SYSVIPC 不影响 Docker 能力。
+# CONFIG_SYSVIPC is not set
+# CONFIG_SYSVIPC_SYSCTL is not set
+CONFIG_POSIX_MQUEUE=y
+CONFIG_POSIX_MQUEUE_SYSCTL=y
+CONFIG_NAMESPACES=y
+CONFIG_UTS_NS=y
+CONFIG_IPC_NS=y
+CONFIG_USER_NS=y
+CONFIG_PID_NS=y
+CONFIG_NET_NS=y
+CONFIG_CGROUPS=y
+CONFIG_MEMCG=y
+CONFIG_MEMCG_SWAP=y
+CONFIG_MEMCG_SWAP_ENABLED=y
+CONFIG_BLK_CGROUP=y
+CONFIG_CGROUP_WRITEBACK=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_FAIR_GROUP_SCHED=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CPUSETS=y
+CONFIG_PROC_PID_CPUSET=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_CGROUP_PERF=y
+CONFIG_CGROUP_BPF=y
+CONFIG_SOCK_CGROUP_DATA=y
+CONFIG_CGROUP_NET_CLASSID=y
+CONFIG_CGROUP_NET_PRIO=y
+CONFIG_SECCOMP_FILTER=y
+CONFIG_OVERLAY_FS=y
+CONFIG_KEYS=y
+CONFIG_VETH=y
+CONFIG_BRIDGE=y
+CONFIG_BRIDGE_NETFILTER=y
+CONFIG_BRIDGE_IGMP_SNOOPING=y
+CONFIG_MACVLAN=y
+CONFIG_IP_VS=y
+CONFIG_IP_VS_RR=y
+CONFIG_IP_VS_PROTO_TCP=y
+CONFIG_IP_VS_PROTO_UDP=y
+CONFIG_IP_VS_NFCT=y
+CONFIG_NETFILTER_ADVANCED=y
+CONFIG_NETFILTER_XTABLES=y
+CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
+CONFIG_NETFILTER_XT_MATCH_IPVS=y
+CONFIG_NETFILTER_XT_CONNMARK=y
+CONFIG_NETFILTER_XT_MARK=y
+CONFIG_NETFILTER_XT_NAT=y
+CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
+CONFIG_NETFILTER_XT_TARGET_CT=y
+CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
+CONFIG_NETFILTER_XT_TARGET_NETMAP=y
+CONFIG_NETFILTER_NETLINK=y
+CONFIG_NETFILTER_NETLINK_LOG=y
+CONFIG_NETFILTER_NETLINK_QUEUE=y
+CONFIG_NF_CONNTRACK=y
+CONFIG_NF_CONNTRACK_MARK=y
+CONFIG_NF_NAT=y
+CONFIG_NF_NAT_IPV4=y
+CONFIG_NF_NAT_MASQUERADE_IPV4=y
+CONFIG_NF_NAT_REDIRECT=y
+CONFIG_NF_REJECT_IPV4=y
+CONFIG_NF_DEFRAG_IPV4=y
+CONFIG_IP_NF_IPTABLES=y
+CONFIG_IP_NF_FILTER=y
+CONFIG_IP_NF_NAT=y
+CONFIG_IP_NF_TARGET_MASQUERADE=y
+CONFIG_IP_NF_MANGLE=y
+CONFIG_IP_NF_RAW=y
+CONFIG_INET_TUNNEL=y
+CONFIG_IPV6=y
+CONFIG_VLAN_8021Q=y
+CONFIG_TUN=y
+CONFIG_NET_CLS=y
+CONFIG_NET_CLS_MATCHALL=y
+CONFIG_FS_POSIX_ACL=y
+CONFIG_F2FS_FS_XATTR=y
+CONFIG_F2FS_FS_POSIX_ACL=y
+CONFIG_TMPFS_XATTR=y
+CONFIG_EXT4_FS_SECURITY=y
+
+# 屏下指纹（对应 docker-enabled-oneplus7t-kernel 的 OPLUS_FINGERPRINT_*，本工程符号名不同）
+CONFIG_INPUT_FINGERPRINT=y
